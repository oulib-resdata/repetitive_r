custom_summary <- function (data){
named_vector <- unlist(lapply(X = data, FUN = mean))
length_vector <- length(named_vector)
results <- list("mtcars_colmeans" = named_vector,
"mtcars_colcounts" = length_vector)
return(results)
}
custom_summary(data=mtcars)
#return(cor_results)
custom_summary(data = parade)
