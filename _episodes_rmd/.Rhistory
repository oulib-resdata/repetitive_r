conversion <- function(value) {
converted <- value*2.14
return(converted)
}
# one inch to 2.14 cm
conversion(1)
conversion <- function(value, conversion_factor) {
converted <- value*conversion_factor
return(converted)
}
# convert inches to cm
conversion(value = 1, conversion_factor = 2.14)
# convert grams to kilograms
conversion(value = 1, conversion_factor = 0.0001)
# convert inches to cm
conversion(value = 1, conversion_factor = 2.14)
# convert grams to kilograms
conversion(value = 1000, conversion_factor = 0.0001)
conversion(value = 1, conversion_factor = 10)
conversion(value = 1)
conversion <- function(value, conversion_factor=2.14) {
converted <- value*conversion_factor
return(converted)
}
conversion(value = 1)
